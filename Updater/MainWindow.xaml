<Window
    x:Class="ShutdownTimer.Updater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="时序 · 更新">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="26"
                Margin="16"
                Padding="38,32,38,32">
            <Grid>
                <!-- 光斑装饰 -->
                <Grid>
                    <Ellipse Width="340" Height="340"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-150,-150,0,0"
                             Opacity="0.55">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8077C4FF" Offset="0"/>
                                <GradientStop Color="#2077C4FF" Offset="0.55"/>
                                <GradientStop Color="#0077C4FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="320" Height="320"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-130,-130"
                             Opacity="0.55">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#80FFA8C4" Offset="0"/>
                                <GradientStop Color="#20FFA8C4" Offset="0.55"/>
                                <GradientStop Color="#00FFA8C4" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <!-- 内容 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="时序 · 更新"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="Microsoft YaHei UI"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="CHRONOS UPDATER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,24"/>
                    </StackPanel>

                    <!-- 状态 -->
                    <TextBlock x:Name="TxtStatus"
                               Grid.Row="1"
                               Text="正在准备更新..."
                               FontSize="13"
                               FontFamily="Microsoft YaHei UI"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- 进度条 + 百分比 + 错误 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Top">
                        <Grid Height="6">
                            <Border CornerRadius="3"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                            <Border x:Name="ProgressFill"
                                    Width="0"
                                    Height="6"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Grid>

                        <TextBlock x:Name="TxtPercent"
                                   Text="0%"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <TextBlock x:Name="TxtError"
                                   Text=""
                                   FontSize="12"
                                   FontFamily="Microsoft YaHei UI"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,18,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- 按钮（失败时才显示） -->
                    <StackPanel x:Name="BottomButtons"
                                Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                Visibility="Collapsed"
                                Margin="0,12,0,0">
                        <Button x:Name="BtnRetry"
                                Content="重试"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="100"
                                Height="36"
                                Click="BtnRetry_Click"/>
                        <Button x:Name="BtnClose"
                                Content="关闭"
                                MinWidth="100"
                                Height="36"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>