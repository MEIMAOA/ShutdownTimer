<Window
    x:Class="ShutdownTimer.Updater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="更新">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 自绘标题栏（标题 + 系统原生窗口按钮）==================== -->
        <Grid x:Name="TitleBarRegion" Grid.Row="0" Height="36" Background="Transparent">
            <TextBlock x:Name="TxtTitleBar"
                       Text="更新"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="440"/>
        </Grid>

        <!-- ==================== 内容 ==================== -->
        <Grid Grid.Row="1" Padding="44,14,44,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ① 应用名 -->
            <TextBlock x:Name="TxtAppName"
                       Grid.Row="0"
                       Text="时序"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"/>

            <!-- ② 正在更新到新版本 X -->
            <TextBlock x:Name="TxtStatus"
                       Grid.Row="1"
                       Text="正在更新..."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- ③ 进度条 -->
            <Grid Grid.Row="2" Height="4" Margin="0,26,0,10">
                <Border CornerRadius="2"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Border x:Name="ProgressFill"
                        Width="0"
                        Height="4"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Grid>

            <!-- ④ 进度文字 + 百分比 -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <TextBlock x:Name="TxtProgressLabel"
                           Text="正在准备..."
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtPercent"
                           Text="0%"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- ⑤ 更新内容 -->
            <Border Grid.Row="4"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    Padding="16,12,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtNotes"
                               Text=""
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- ⑥ 错误 + 按钮 -->
            <StackPanel Grid.Row="5" Margin="0,14,0,0">
                <TextBlock x:Name="TxtError"
                           Text=""
                           FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="BottomButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed"
                            Margin="0,12,0,0">
                    <Button x:Name="BtnRetry"
                            Content="重试"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="110"
                            Height="36"
                            Click="BtnRetry_Click"/>
                    <Button x:Name="BtnClose"
                            Content="关闭"
                            MinWidth="110"
                            Height="36"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
