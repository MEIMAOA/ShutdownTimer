<Window
    x:Class="ShutdownTimer.Updater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="更新">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <!-- 顶部淡色光斑 -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="520" Height="360"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,-170,0,0" Opacity="0.45">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5C7CB8FF" Offset="0"/>
                        <GradientStop Color="#1A7CB8FF" Offset="0.6"/>
                        <GradientStop Color="#007CB8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid Padding="44,34,44,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ① Logo + 应用名 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="14">
                <Border Width="58" Height="58" CornerRadius="16" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF5B8CFF" Offset="0"/>
                            <GradientStop Color="#FF7C5CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon Glyph="&#xE823;" FontSize="28"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TxtAppName"
                           Text="时序"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ② 正在更新到新版本 X -->
            <TextBlock x:Name="TxtStatus"
                       Grid.Row="1"
                       Text="正在更新..."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,26,0,0"/>

            <!-- ③ 进度条 -->
            <Grid Grid.Row="2" Height="4" Margin="0,22,0,10">
                <Border CornerRadius="2"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"/>
                <Border x:Name="ProgressFill"
                        Width="0"
                        Height="4"
                        CornerRadius="2"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
            </Grid>

            <!-- ④ 进度文字 + 百分比 -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <TextBlock x:Name="TxtProgressLabel"
                           Text="正在准备..."
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtPercent"
                           Text="0%"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- ⑤ 更新内容框 -->
            <Border Grid.Row="4"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    Padding="16,12,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="TxtNotes"
                               Text=""
                               FontSize="12"
                               LineHeight="20"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- ⑥ 错误 + 按钮 -->
            <StackPanel Grid.Row="5" Margin="0,14,0,0">
                <TextBlock x:Name="TxtError"
                           Text=""
                           FontSize="12"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="BottomButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed"
                            Margin="0,12,0,0">
                    <Button x:Name="BtnRetry"
                            Content="重试"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="110"
                            Height="36"
                            Click="BtnRetry_Click"/>
                    <Button x:Name="BtnClose"
                            Content="关闭"
                            MinWidth="110"
                            Height="36"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
