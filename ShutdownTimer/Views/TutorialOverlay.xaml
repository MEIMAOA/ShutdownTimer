<UserControl
    x:Class="ShutdownTimer.Views.TutorialOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 全屏遮罩，禁止点击背后内容 -->
    <Grid Background="#CC000000">
        <Border Background="{ThemeResource SettingsCardBackgroundBrush}"
                BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                BorderThickness="1"
                Width="520"
                MaxHeight="500"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
                    <TextBlock x:Name="StepLabel" FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- 内容 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ContentText" TextWrapping="Wrap"
                               LineHeight="24"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>

                <!-- ★ 底部：进度条在上，按钮在右下 -->
                <StackPanel Grid.Row="2" Spacing="12" Margin="0,20,0,0">
                    <!-- 进度条 -->
                    <ProgressBar x:Name="StepProgress"
                                 Height="4"
                                 Maximum="1" Value="0"
                                 HorizontalAlignment="Stretch"/>

                    <!-- 按钮行（右对齐） -->
                    <Grid>
                        <Button x:Name="NextButton"
                                Content="下一步"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Next_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>