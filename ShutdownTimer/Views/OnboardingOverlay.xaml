<UserControl
    x:Class="ShutdownTimer.Views.OnboardingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- 全屏遮罩 -->
	<Grid Background="#D9000000">
		<Border Background="{ThemeResource SettingsCardBackgroundBrush}"
                BorderBrush="{ThemeResource SettingsCardBorderBrush}"
                BorderThickness="1"
                Width="620"
                MaxHeight="600"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40,32">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!-- 步骤指示 + 标题 -->
				<StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
					<TextBlock x:Name="StepLabel"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
					<TextBlock x:Name="TitleText"
                               FontSize="26"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
				</StackPanel>

				<!-- 内容区 -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="12">

						<TextBlock x:Name="ContentText"
                                   TextWrapping="Wrap"
                                   LineHeight="26"
                                   FontSize="15"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

						<!-- 配置方案选项 -->
						<StackPanel x:Name="ConfigOptions" Spacing="12"
                                    Visibility="Collapsed" Margin="0,8,0,0">
							<RadioButton x:Name="RecommendedRadio" GroupName="config" IsChecked="True">
								<StackPanel>
									<TextBlock Text="⭐ 推荐配置" FontWeight="Bold"/>
									<TextBlock Text="每晚 23:00 自动关机，开启开机自启、系统托盘与背景图。适合大多数用户。"
                                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
								</StackPanel>
							</RadioButton>
							<RadioButton x:Name="CustomRadio" GroupName="config">
								<StackPanel>
									<TextBlock Text="⚙️ 自定义配置" FontWeight="Bold"/>
									<TextBlock Text="保持默认值，稍后由你自己在设置里调整各项功能。"
                                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
								</StackPanel>
							</RadioButton>
							<RadioButton x:Name="MinimalRadio" GroupName="config">
								<StackPanel>
									<TextBlock Text="🍃 极简配置" FontWeight="Bold"/>
									<TextBlock Text="不开启任何自动功能，只保留基础界面。"
                                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
								</StackPanel>
							</RadioButton>
						</StackPanel>

						<!-- ★ 个性化选项 -->
						<StackPanel x:Name="PersonalOptions" Spacing="12"
                                    Visibility="Collapsed" Margin="0,8,0,0">

							<!-- 头像 + 用户名（一行两列） -->
							<Grid ColumnSpacing="20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<!-- 头像选择 -->
								<StackPanel Grid.Column="0" Spacing="6">
									<TextBlock FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}">
										<Run Text="头像"/>
										<Run Text="*" Foreground="Red"/>
									</TextBlock>

									<Border Width="100" Height="100"
                                            CornerRadius="50"
                                            BorderThickness="2"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            HorizontalAlignment="Left">
										<Grid>
											<!-- 无头像时的占位图标 -->
											<FontIcon x:Name="AvatarPlaceholder"
                                                      Glyph="&#xE77B;"
                                                      FontSize="48"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

											<!-- 选择的头像 -->
											<Image x:Name="AvatarPreview"
                                                   Stretch="UniformToFill"
                                                   Visibility="Collapsed"/>
										</Grid>
									</Border>

									<Button x:Name="ChooseAvatarButton"
                                            Content="选择图片"
                                            HorizontalAlignment="Left"
                                            Click="ChooseAvatar_Click"/>
								</StackPanel>

								<!-- 用户名 -->
								<StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
									<TextBlock FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}">
										<Run Text="你的称呼"/>
										<Run Text="*" Foreground="Red"/>
									</TextBlock>

									<TextBox x:Name="NameBox"
                                             PlaceholderText="必填，例如：小明"
                                             MaxLength="20"/>

									<TextBlock x:Name="NameError"
                                               Text=""
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="Collapsed"/>
								</StackPanel>
							</Grid>

							<!-- 分隔线 -->
							<Rectangle Height="1" Margin="0,4"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

							<!-- 主题选择 -->
							<TextBlock Text="界面主题" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
							<RadioButton x:Name="SystemThemeRadio" GroupName="theme"
                                         Content="跟随系统" IsChecked="True"/>
							<RadioButton x:Name="LightThemeRadio" GroupName="theme" Content="浅色"/>
							<RadioButton x:Name="DarkThemeRadio" GroupName="theme" Content="深色"/>
						</StackPanel>

					</StackPanel>
				</ScrollViewer>

				<!-- 进度条 -->
				<ProgressBar x:Name="StepProgress"
                             Grid.Row="2"
                             Height="4"
                             Maximum="1" Value="0"
                             Margin="0,20,0,0"
                             HorizontalAlignment="Stretch"/>

				<!-- 按钮行 -->
				<Grid Grid.Row="3" Margin="0,16,0,0">
					<Button x:Name="NextButton"
                            Content="下一步"
                            HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Next_Click"/>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>