<Window
    x:Class="ShutdownTimer.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="欢迎 - 初始化配置">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤 1：欢迎 -->
        <StackPanel x:Name="Step1" Grid.Row="0" Spacing="16" Padding="60,80">
            <TextBlock Text="👋 欢迎使用时序" FontSize="32" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="一个帮你管理电脑、让作息更规律的小助手。"
                       FontSize="16" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="接下来只需 4 步就能完成初始化配置。"
                       FontSize="16" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="每个步骤都有详细说明，点击「下一步」继续。"
                       FontSize="14" TextWrapping="Wrap" Margin="0,20,0,0"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- 步骤 2：选择配置方案 -->
        <StackPanel x:Name="Step2" Grid.Row="0" Spacing="12" Padding="60,50" Visibility="Collapsed">
            <TextBlock Text="选择配置方案" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="根据你的使用习惯选择，稍后随时可以修改。"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <RadioButton x:Name="RecommendedRadio" GroupName="config" IsChecked="True" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="⭐ 推荐配置" FontWeight="Bold"/>
                    <TextBlock Text="每晚 23:00 自动关机，开启开机自启、系统托盘。适合大多数用户。"
                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="CustomRadio" GroupName="config">
                <StackPanel>
                    <TextBlock Text="⚙️ 自定义配置" FontWeight="Bold"/>
                    <TextBlock Text="保持默认值，稍后由你自己在设置里调整各项功能。"
                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="MinimalRadio" GroupName="config">
                <StackPanel>
                    <TextBlock Text="🍃 极简配置" FontWeight="Bold"/>
                    <TextBlock Text="不开启任何自动功能，只保留基础界面。"
                               TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- 步骤 3：个性化 -->
        <StackPanel x:Name="Step3" Grid.Row="0" Spacing="12" Padding="60,50" Visibility="Collapsed">
            <TextBlock Text="个性化" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="让程序更符合你的风格。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock Text="你的称呼（可选）" FontWeight="SemiBold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBox x:Name="NameBox" PlaceholderText="输入你的名字"/>

            <TextBlock Text="界面主题" FontWeight="SemiBold" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <RadioButton x:Name="SystemThemeRadio" GroupName="theme" Content="跟随系统" IsChecked="True"/>
            <RadioButton x:Name="LightThemeRadio" GroupName="theme" Content="浅色"/>
            <RadioButton x:Name="DarkThemeRadio" GroupName="theme" Content="深色"/>
        </StackPanel>

        <!-- 步骤 4：完成 -->
        <StackPanel x:Name="Step4" Grid.Row="0" Spacing="16" Padding="60,50" Visibility="Collapsed">
            <TextBlock Text="🎉 全部就绪！" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="配置已保存。你可以随时通过左侧导航切换功能页面。"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="每个页面首次进入时都会显示使用教程，逐步教你操作。"
                       TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="点击「完成」启动程序。"
                       FontWeight="SemiBold" Margin="0,20,0,0"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </StackPanel>

        <!-- 底部：步骤 + 按钮 -->
        <Grid Grid.Row="1" Padding="60,20"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StepIndicator" Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <Button x:Name="BackButton" Grid.Column="1" Content="上一步"
                    Margin="0,0,8,0" Click="Back_Click"/>

            <Button x:Name="NextButton" Grid.Column="2" Content="下一步"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Next_Click"/>
        </Grid>
    </Grid>
</Window>