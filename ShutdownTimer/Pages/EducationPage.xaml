<Page
    x:Class="ShutdownTimer.Pages.EducationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <TextBlock Text="软件管控"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="教育分支版专属：禁止打开或限制软件的使用时长与使用时间段"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,16"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="12">

                    <TextBlock Text="添加管控规则"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <TextBox x:Name="ProcessNameBox"
                             PlaceholderText="进程名或完整路径，如 game 或 C:\path\game.exe"/>

                    <ComboBox x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Left" MinWidth="180">
                        <ComboBoxItem Content="完全禁止" Tag="0"/>
                        <ComboBoxItem Content="每日限时" Tag="1"/>
                        <ComboBoxItem Content="不限时长" Tag="-1"/>
                    </ComboBox>

                    <StackPanel x:Name="MinutesPanel" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="每日最多使用（分钟）："
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <NumberBox x:Name="MinutesBox" Width="140"
                                   Minimum="1" Maximum="1440" Value="60"
                                   SpinButtonPlacementMode="Compact"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <ToggleSwitch x:Name="WindowSwitch"
                                      Header="限制使用时间段"
                                      OffContent="不限制"
                                      OnContent="仅允许在以下时间段使用"
                                      Toggled="WindowSwitch_Toggled"/>
                        <StackPanel x:Name="WindowPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <TimePicker x:Name="StartTime" ClockIdentifier="24HourClock" MinuteIncrement="5"/>
                            <TextBlock Text="—" VerticalAlignment="Center"/>
                            <TimePicker x:Name="EndTime" ClockIdentifier="24HourClock" MinuteIncrement="5"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="添加"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Add_Click"/>

                </StackPanel>
            </Border>

            <TextBlock x:Name="EmptyHint"
                       Text="尚未添加任何规则"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="Collapsed"
                       Margin="0,4,0,0"/>

            <StackPanel x:Name="RulesPanel" Spacing="4"/>

        </StackPanel>
    </ScrollViewer>
</Page>
