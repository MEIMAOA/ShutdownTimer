<Page
    x:Class="ShutdownTimer.Pages.EducationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <TextBlock Text="软件管控"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="教育分支版专属：禁止打开特定软件"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,16"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="12">

                    <StackPanel Spacing="4">
                        <TextBlock Text="添加被禁止的软件"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="输入进程名（例如 game、steam），程序会周期结束这些进程"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="ProcessNameBox"
                                 PlaceholderText="进程名，如 game（可省略 .exe）"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="添加"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Add_Click"/>
                    </Grid>

                    <TextBlock x:Name="EmptyHint"
                               Text="尚未添加任何软件"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="BlockedListPanel" Spacing="4"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
