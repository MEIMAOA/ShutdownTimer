<Page
    x:Class="ShutdownTimer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="主页"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="来自 GitHub 的最新资讯"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="刷新"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Refresh_Click"/>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Text="正在加载…"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <ItemsControl x:Name="RepoList" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,8">
                            <StackPanel Spacing="6">

                                <HyperlinkButton Content="{Binding FullName}"
                                                 Tag="{Binding}"
                                                 Click="RepoLink_Click"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"/>

                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <TextBlock Text="{Binding StatsText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock Text="{Binding ReleaseText}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                <TextBlock Text="{Binding NotesText}"
                                           TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
