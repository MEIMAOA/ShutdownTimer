<Page
    x:Class="ShutdownTimer.Pages.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <!-- 标题 -->
            <TextBlock Text="检查更新"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="从 GitHub Releases 获取最新版本"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,16"/>

            <!-- 版本信息 -->
            <TextBlock Text="版本信息"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,4"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="当前版本"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionText"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="检查更新"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CheckUpdate_Click"/>
                </Grid>
            </Border>

            <!-- 更新渠道 -->
            <TextBlock Text="更新渠道"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,4"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="选择从哪个渠道接收更新"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <RadioButton x:Name="OfficialChannelRadio"
                                 Content="正式版"
                                 GroupName="UpdateChannel"
                                 Checked="Channel_Changed"/>
                    <RadioButton x:Name="EducationChannelRadio"
                                 Content="教育分支版（含软件管控功能）"
                                 GroupName="UpdateChannel"
                                 Checked="Channel_Changed"/>
                </StackPanel>
            </Border>

            <!-- 更新内容 -->
            <TextBlock Text="更新"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,4"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="12">

                    <TextBlock x:Name="StatusText"
                               Text="点击上方「检查更新」按钮开始检测。"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <ProgressBar x:Name="DownloadProgress"
                                 Maximum="100"
                                 Value="0"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Stretch"/>

                    <Button x:Name="InstallButton"
                            Content="下载并安装更新"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="InstallUpdate_Click"/>

                </StackPanel>
            </Border>

            <!-- 说明 -->
            <TextBlock Text="关于自动更新"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,4"/>

            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="• 更新包从 GitHub Releases 下载，格式为 zip"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="• 下载完成后程序会自动退出，重启后即为新版本"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="• 更新期间请勿手动关闭程序，否则可能导致更新失败"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="• 如自动更新失败，可手动下载 zip 解压覆盖"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>