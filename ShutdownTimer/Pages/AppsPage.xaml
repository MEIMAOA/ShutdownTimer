<Page
    x:Class="ShutdownTimer.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

	<Grid Padding="32,24,32,24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,16">
			<TextBlock Text="应用管理"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
			<TextBlock Text="查看和卸载系统上已安装的应用"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       Opacity="0.75"
                       Margin="0,4,0,0"/>
		</StackPanel>

		<Grid Grid.Row="1" Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     PlaceholderText="搜索应用名称…"
                     TextChanged="SearchBox_TextChanged"/>

			<StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="8,0,0,0">
				<Button Content="刷新" Click="Refresh_Click"/>
				<TextBlock x:Name="CountText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.7"/>
			</StackPanel>
		</Grid>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="ItemsHost">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,0,0,6">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<!-- ★ 图标 -->
								<Image Grid.Column="0"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Source="{Binding Icon}"/>

								<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
									<TextBlock Text="{Binding Name}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
									<TextBlock Text="{Binding Publisher}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"/>
								</StackPanel>

								<TextBlock Grid.Column="2"
                                           Text="{Binding Version}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           Opacity="0.7"
                                           MinWidth="60"
                                           Margin="12,0,12,0"
                                           TextAlignment="Right"/>

								<!-- ★ 卸载按钮 -->
								<Button Grid.Column="3"
                                        Content="卸载"
                                        VerticalAlignment="Center"
                                        Tag="{Binding}"
                                        Click="Uninstall_Click"/>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</Page>