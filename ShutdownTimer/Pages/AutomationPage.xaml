<Page
    x:Class="ShutdownTimer.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="32,24,32,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8">

            <TextBlock Text="自动化" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="让电脑按计划自动执行任务" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,16"/>

            <TextBlock Text="定时重启" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="每天自动重启" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="到达指定时间后自动重启电脑" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TimePicker Grid.Column="1" x:Name="RestartTime" Margin="8,0"
                                VerticalAlignment="Center" ClockIdentifier="24HourClock"
                                MinuteIncrement="1" SelectedTimeChanged="RestartTime_Changed"/>
                    <ToggleSwitch Grid.Column="2" x:Name="RestartSwitch" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="RestartSwitch_Toggled"/>
                </Grid>
            </Border>

            <TextBlock Text="定时休眠" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,4"/>
            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="每天自动休眠" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="到达指定时间后自动进入休眠" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TimePicker Grid.Column="1" x:Name="HibernateTime" Margin="8,0"
                                VerticalAlignment="Center" ClockIdentifier="24HourClock"
                                MinuteIncrement="1" SelectedTimeChanged="HibernateTime_Changed"/>
                    <ToggleSwitch Grid.Column="2" x:Name="HibernateSwitch" MinWidth="0"
                                  VerticalAlignment="Center" Toggled="HibernateSwitch_Toggled"/>
                </Grid>
            </Border>

            <TextBlock Text="定时锁定" Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,4"/>
            <Border Style="{StaticResource SettingsCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="无操作后自动锁定" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="设为 0 分钟则关闭此功能" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <NumberBox Grid.Column="1" x:Name="LockMinutesBox" Width="120" Minimum="0" Maximum="480"
                               SpinButtonPlacementMode="Compact" ValueChanged="LockMinutes_Changed"/>
                </Grid>
            </Border>

            <Button Content="立即测试：锁定屏幕" Click="TestLock_Click" Margin="0,16,0,0"/>
            <Button Content="立即测试：休眠" Click="TestHibernate_Click"/>
            <Button Content="取消已计划的关机/重启" Click="Abort_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>