<Window
    x:Class="ShutdownTimer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Chronos-MainWindow">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 背景图 -->
        <Image x:Name="BackgroundImage" Grid.RowSpan="2"
               Stretch="UniformToFill" Visibility="Collapsed"/>
        <Rectangle x:Name="BackgroundMask" Grid.RowSpan="2"
                   Fill="#30000000" Visibility="Collapsed"/>

        <!-- 标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="TitleBarText"
                       Text="时序"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>

        <!-- 左侧导航 + 内容区 -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="320"
                        SelectionChanged="NavView_SelectionChanged"
                        Background="Transparent">

            <!-- ★ 左上角 16:9 大卡片 -->
            <NavigationView.PaneHeader>
                <Grid Padding="16,14,16,14">
                    <Viewbox Stretch="Uniform"
                             HorizontalAlignment="Left"
                             MaxWidth="288">
                        <!-- 固定 272×153（16:9），由 Viewbox 缩放 -->
                        <Grid Width="272" Height="153">

                            <!-- 渐变背景 -->
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                                        <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- 右上角装饰光斑 -->
                            <Ellipse Width="160" Height="160"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-80,-80,0"
                                     Opacity="0.2"
                                     Fill="White"/>

                            <!-- 左下角装饰光斑 -->
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="-60,0,0,-60"
                                     Opacity="0.12"
                                     Fill="White"/>

                            <!-- 内容：头像 + 用户名 -->
                            <StackPanel Margin="20,0"
                                        VerticalAlignment="Center"
                                        Spacing="12">

                                <!-- 头像（64×64 圆形） -->
                                <Border Width="64" Height="64"
                                        CornerRadius="32"
                                        BorderThickness="3"
                                        BorderBrush="White"
                                        HorizontalAlignment="Left"
                                        Background="#40FFFFFF">
                                    <Grid>
                                        <FontIcon x:Name="HeaderAvatarPlaceholder"
                                                  Glyph="&#xE77B;"
                                                  FontSize="28"
                                                  Foreground="White"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        <Image x:Name="HeaderAvatar"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                    </Grid>
                                </Border>

                                <!-- 用户名 -->
                                <TextBlock x:Name="HeaderUserName"
                                           Text="时序用户"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="232"/>
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="定时关机" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="启动项" Tag="startup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="应用" Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="系统状态" Tag="sysstatus">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="清理优化" Tag="cleanup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="网络连接" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="系统监控" Tag="monitoring">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="常用工具" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC7A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="安全隐私" Tag="security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="自动化" Tag="automation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="外观体验" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="检查更新" Tag="update">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="EducationNavItem"
                                    Content="软件管控" Tag="education"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent"/>
        </NavigationView>

        <!-- 微软账户浮动提示条 -->
        <InfoBar x:Name="MsAccountInfoBar"
                 Grid.Row="0" Grid.RowSpan="2"
                 VerticalAlignment="Top"
                 Margin="8,40,8,0"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational"
                 Title="建议登录微软账户"
                 Message="登录后可跨设备同步设置、更方便找回密码，还能使用 OneDrive。">
            <InfoBar.ActionButton>
                <Button Content="去登录" Click="LoginMsAccount_Click"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 浮层宿主 -->
        <Grid x:Name="OverlayHost"
              Grid.RowSpan="2"
              Visibility="Collapsed"/>
    </Grid>
</Window>